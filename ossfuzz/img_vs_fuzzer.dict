# Signatures and structure markers for the img/vs layer; see
# tsk/util/detect_encryption.c, tsk/img/img_open.cpp and tsk/vs/*
signature_luks="LUKS\xba\xbe"
signature_bitlocker="-FVE-FS-"
signature_filevault="encrdsa"
signature_checkpoint="Protect"
signature_safeboot="Safeboot"
signature_safeboot2="SafeBoot"
signature_guardian="PCGM"
signature_sophos="SGM400"
signature_sophos2="SGE400"
signature_winmagic="WMSD"
signature_pgp="\xeb\x48\x90PGPGUARD"
mbr_signature="\x55\xaa"
gpt_header="EFI PART"
bsd_magic="\x57\x45\x56\x82"
mbr_part_fat32="\x0b"
mbr_part_freebsd="\xa5"
mbr_part_gpt="\xee"
